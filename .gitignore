# Root gitignore for monorepo (backend + frontend)

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.next/
frontend/.nuxt/
frontend/.output/
frontend/.turbo/
frontend/.vercel/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Env
*.env
*.env.local
backend/.env
frontend/.env

# Python
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/

# IDE/editor
.vscode/
.idea/
.DS_Store
Thumbs.db

# Coverage
coverage/
.coverage
htmlcov/

# Build artifacts
build/
