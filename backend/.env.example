# =============================================
# 🔐 Environment Configuration for Backend
# =============================================

# --- Core API Keys ---

# Optional: Required if you use LangChain with OpenAI models
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps Geocoding API (for location intelligence)
# GOOGLE_MAPS_API_KEY (removed for prototype)

# OpenFDA API (optional; basic queries need no key)
OPENFDA_API_KEY=

# --- Optional External APIs (for insights/research) ---

# Europe PMC API (for medical literature search)
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/

# WHO GHO API (for health statistics)
WHO_GHO_BASE_URL=https://ghoapi.azureedge.net/api/

# World Bank API (for global resource data)
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2/

# --- App Configuration ---

APP_NAME=Medical Resource Allocation AI Agent
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=1

# --- Inventory Data ---
# Path to the inventory CSV file.
# Use a relative path from repo root or absolute path. Default is dataset.csv at repo root.
# Example overrides:
# INVENTORY_CSV_PATH=dataset.csv
# INVENTORY_CSV_PATH=backend/data/inventory.csv
INVENTORY_CSV_PATH=dataset.csv
